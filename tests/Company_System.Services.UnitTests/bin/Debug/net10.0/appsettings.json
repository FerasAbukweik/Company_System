{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "InstanceName" : "Company_System_Cache",
    "SlidingExpiration": 15,
    "AbsoluteExpiration": 60
  },
  "Jwt": {
    "Issuer": "https://localhost:8081",
    "Audience": "https://localhost:4000;https://localhost:4200",
    "AccessTokenLifeTime" : 15,
    "RefreshTokenLifeTime": 10080
  },
  "CookieKeys": {
    "AccessToken": "dhAS7aADFu",
    "RefreshToken": "LDa78ANLDls"
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
